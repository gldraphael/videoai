FROM docker.io/library/node:26-bookworm-slim AS build

WORKDIR /app

RUN npm install --global pnpm@11.18.0

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY services/webapp/package.json services/webapp/package.json
COPY services/api/package.json services/api/package.json
COPY tools/seed/package.json tools/seed/package.json
RUN pnpm install --frozen-lockfile

COPY services/webapp services/webapp
RUN pnpm --filter @videoai/webapp build

FROM docker.io/library/caddy:2-alpine

COPY services/webapp/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/services/webapp/dist /usr/share/caddy

EXPOSE 5173
